{
  "activationEvents": [
    "onView:signboard.board",
    "onCommand:signboard.showLed",
    "onCommand:signboard.showFlap",
    "onCommand:signboard.cycleTheme"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "signboard.mode": {
          "default": "flap",
          "description": "%config.mode.description%",
          "enum": [
            "flap",
            "led",
            "auto"
          ],
          "enumDescriptions": [
            "%config.mode.flap%",
            "%config.mode.led%",
            "%config.mode.auto%"
          ],
          "type": "string"
        },
        "signboard.ledPitch": {
          "type": "number",
          "default": 3,
          "minimum": 3,
          "maximum": 12,
          "description": "%config.ledPitch.description%"
        },
        "signboard.ledHole": {
          "type": "number",
          "default": 38,
          "minimum": 25,
          "maximum": 48,
          "description": "%config.ledHole.description%"
        },
        "signboard.ledGlow": {
          "type": "boolean",
          "default": true,
          "description": "%config.ledGlow.description%"
        }
      },
      "title": "%config.title%"
    },
    "views": {
      "explorer": [
        {
          "id": "signboard.board",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "signboard.showLed",
        "title": "%command.showLed.title%",
        "icon": "$(dashboard)"
      },
      {
        "command": "signboard.showFlap",
        "title": "%command.showFlap.title%",
        "icon": {
          "light": "media/flight-light.svg",
          "dark": "media/flight-dark.svg"
        }
      },
      {
        "command": "signboard.cycleTheme",
        "title": "Signboard: Switch Colour Theme",
        "icon": "$(symbol-color)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "signboard.cycleTheme",
          "when": "view == signboard.board",
          "group": "navigation@1"
        },
        {
          "command": "signboard.showLed",
          "when": "view == signboard.board && !signboard.isLed",
          "group": "navigation@2"
        },
        {
          "command": "signboard.showFlap",
          "when": "view == signboard.board && signboard.isLed",
          "group": "navigation@2"
        }
      ]
    }
  },
  "description": "%extension.description%",
  "displayName": "Signboard-Solo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "signboard",
    "split-flap",
    "arrivals",
    "tabs",
    "ambient"
  ],
  "license": "MIT",
  "main": "./src/extension.js",
  "name": "signboard-solo",
  "publisher": "masanori-satake",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/model.js && node --check media/board.js && node --check media/led.js",
    "package": "npm run check-version && npx @vscode/vsce package",
    "test": "node --test test/*.test.js",
    "check-version": "node scripts/check-version.js",
    "check-version-bump": "node scripts/check-version.js --check-bump",
    "update-version": "node scripts/update-version.js",
    "vscode:prepublish": "npm run check && npm test"
  },
  "version": "1.9.1",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/Signboard-Solo"
  },
  "homepage": "https://github.com/masanori-satake/Signboard-Solo#readme",
  "bugs": {
    "url": "https://github.com/masanori-satake/Signboard-Solo/issues"
  }
}
