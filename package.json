{
  "activationEvents": [
    "onView:signboard.board"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "signboard.mode": {
          "default": "flap",
          "description": "Display mode. Phase 1 implements flap; led and auto arrive in later phases and fall back to flap until then.",
          "enum": [
            "flap",
            "led",
            "auto"
          ],
          "enumDescriptions": [
            "Airport split-flap arrivals board",
            "Station LED dot-matrix board (Phase 2)",
            "Automatic by view width (Phase 3)"
          ],
          "type": "string"
        }
      },
      "title": "Signboard-Solo"
    },
    "views": {
      "explorer": [
        {
          "id": "signboard.board",
          "name": "到着案内 / Arrivals",
          "type": "webview"
        }
      ]
    }
  },
  "description": "Your open tabs as an airport split-flap arrivals board. Deliberately useless, quietly soothing. 開いているタブを空港の到着案内板（パタパタ）で表示する、実用性ゼロの癒し拡張。",
  "displayName": "Signboard-Solo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": [
    "signboard",
    "split-flap",
    "arrivals",
    "tabs",
    "ambient"
  ],
  "license": "MIT",
  "main": "./src/extension.js",
  "name": "signboard-solo",
  "publisher": "masanori-satake",
  "scripts": {
    "check": "node --check src/extension.js && node --check src/model.js && node --check media/board.js",
    "package": "npx @vscode/vsce package",
    "test": "node --test test/*.test.js"
  },
  "version": "0.2.0"
}
